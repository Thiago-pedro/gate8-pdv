{
  "expo": {
    "name": "Gate8 PDV",
    "slug": "gate8-pdv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gate8pdv",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "backgroundColor": "#0b1730",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.gate8.pdv",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "gate8"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "club.gate8.pdv",
      "adaptiveIcon": {
        "backgroundColor": "#00041D",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-pdv.jpg",
          "resizeMode": "cover",
          "backgroundColor": "#01020B",
          "enableFullScreenImage_legacy": true,
          "android": {
            "image": "./assets/images/splash-blank.png",
            "backgroundColor": "#01020B",
            "imageWidth": 1
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "A Gate8 PDV usa suas fotos para a imagem do produto.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
