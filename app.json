{
  "expo": {
    "name": "Gate8 PDV",
    "slug": "gate8-pdv",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gate8pdv",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "backgroundColor": "#0b1730",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "club.gate8.pdv",
      "infoPlist": {
        "LSApplicationQueriesSchemes": [
          "gate8"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "package": "club.gate8.pdv",
      "adaptiveIcon": {
        "backgroundColor": "#050d1f",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-8.png",
          "resizeMode": "contain",
          "backgroundColor": "#050d1f",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
